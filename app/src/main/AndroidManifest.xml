<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- La señal del wifi, para el registro de fallas (diag/Registro.kt). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Para ofrecer la instalacion del APK nuevo. Android siempre pide
         confirmacion al usuario; esto solo permite abrir ese dialogo. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- largeHeap: el video guardado por adelantado y las portadas del catalogo
         viven en memoria. En un televisor de poca memoria el tope normal de una
         app se alcanza a mitad de una pelicula. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.Orbita"
        android:usesCleartextTraffic="true">

        <!-- Sin orientacion fija: un televisor no rota igual, y en un telefono la
             lista se puede usar en vertical. El reproductor pide horizontal por
             su cuenta mientras esta en pantalla, y la devuelve al salir. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Orbita">
            <!-- Solo LAUNCHER. Declarar aqui tambien LEANBACK_LAUNCHER hacia que
                 algunos lanzadores de telefono crearan un acceso por categoria,
                 y aparecia la app duplicada. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La entrada del televisor, apuntando a la misma actividad. Cada
             lanzador encuentra exactamente una: el del telefono busca LAUNCHER,
             el del televisor busca LEANBACK_LAUNCHER. -->
        <activity-alias
            android:name=".TvLauncherAlias"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Entrega el APK descargado al instalador de Android. Desde Android 7
             no se puede pasar un file:// a otra app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
