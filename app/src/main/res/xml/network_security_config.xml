<?xml version="1.0" encoding="utf-8"?>
<!-- Los paneles Xtream casi siempre sirven en HTTP plano y en puertos no
     estandar. Sin esto, Android 9+ bloquea el stream en silencio. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
